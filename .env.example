# ── Database (Neon) ────────────────────────────────────────────
DATABASE_URL=                         # Neon pooled connection string
DATABASE_URL_UNPOOLED=                # Neon direct (for drizzle-kit migrations)

# ── Auth (Better Auth) ────────────────────────────────────────
BETTER_AUTH_SECRET=                   # Random 32+ char secret (openssl rand -base64 32)
BETTER_AUTH_URL=http://localhost:3000 # Change to production URL on deploy

# ── Email (Resend) ────────────────────────────────────────────
RESEND_API_KEY=                       # Get from resend.com

# ── Billing (Lemon Squeezy) ───────────────────────────────────
LEMONSQUEEZY_API_KEY=                 # LS API key (Settings → API)
LEMONSQUEEZY_STORE_ID=               # LS Store ID (numeric)
LEMONSQUEEZY_PRO_VARIANT_ID=         # Variant ID of your Pro product
LEMONSQUEEZY_WEBHOOK_SECRET=         # Webhook signing secret (LS → Webhooks)

# ── Media (Cloudinary) — optional ────────────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Analytics (Umami) — optional ─────────────────────────────
NEXT_PUBLIC_UMAMI_ID=                 # Umami website ID (shows analytics script if set)

# ── App ───────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Cloudflare Pages build ────────────────────────────────────
# CF_PAGES=1                          # Set to "1" in CF Pages env to enable unoptimized images
